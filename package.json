{
  "name": "achievement-nexus",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "release:validate": "node scripts/validate-release.mjs",
    "release:validate-security": "node scripts/validate-release-security.mjs",
    "test:updates": "node scripts/validate-updates.mjs",
    "test:release-channel": "node --test services/auth-api/tests/releaseChannel.test.mjs && node scripts/validate-r2-release.mjs",
    "release:set-version": "node scripts/set-release-version.mjs",
    "typecheck": "tsc -b --pretty",
    "test:intelligence": "node --experimental-strip-types scripts/validate-intelligence.mjs",
    "test:steam-library": "node --experimental-strip-types scripts/validate-steam-library.mjs",
    "test:steam-achievements": "node --experimental-strip-types scripts/validate-steam-achievements.mjs",
    "test:steam-backend-data": "node --experimental-strip-types --test scripts/validate-steam-backend-data.mjs",
    "test:game-details": "node --experimental-strip-types scripts/validate-game-details.mjs",
    "test:onboarding": "node --experimental-strip-types scripts/validate-onboarding.mjs",
    "test:navigation": "node --experimental-strip-types scripts/validate-navigation.mjs",
    "test:tray-refresh": "node --experimental-strip-types scripts/validate-tray-refresh.mjs",
    "test:quality": "node --experimental-strip-types scripts/validate-quality.mjs",
    "test:statistics": "node --experimental-strip-types scripts/validate-statistics.mjs",
    "test:backend-auth": "npm --prefix services/auth-api test",
    "test:backend-storage": "npm --prefix services/auth-api run test:storage",
    "test:backend-postgres": "npm --prefix services/auth-api run test:postgres",
    "test:steam-openid": "npm --prefix services/auth-api run test:steam-openid",
    "steam-openid:live-test": "npm --prefix services/auth-api run steam-openid:live-test",
    "test:steam-openid-desktop": "node --experimental-strip-types --test scripts/validate-steam-openid-desktop.mjs",
    "test:csp": "node scripts/validate-tauri-csp.mjs",
    "test:smart-sync": "node --experimental-strip-types --test scripts/validate-smart-sync.mjs",
    "test:smart-library": "node --experimental-strip-types scripts/validate-smart-library.mjs",
    "test:game-launcher": "node --experimental-strip-types scripts/validate-game-launcher.mjs",
    "test:themes": "node --experimental-strip-types scripts/validate-themes.mjs",
    "test:nexus-glass": "node scripts/validate-nexus-glass.mjs",
    "test:arabic-typography": "node --experimental-strip-types scripts/validate-arabic-typography.mjs",
    "test:tools": "node --experimental-strip-types scripts/validate-tools.mjs",
    "test:tool-ratings": "node --experimental-strip-types scripts/validate-tool-ratings.mjs",
    "test:tool-reviews": "node --experimental-strip-types scripts/validate-tool-reviews.mjs",
    "test:native-ux": "node --experimental-strip-types scripts/validate-native-ux.mjs",
    "test:achievement-icons": "node --experimental-strip-types scripts/validate-achievement-icons.mjs",
    "test:achievement-toasts": "node --experimental-strip-types scripts/validate-achievement-toasts.mjs",
    "test:ux-copy": "node --experimental-strip-types scripts/validate-ux-microcopy.mjs",
    "test:steam-artwork": "node --experimental-strip-types scripts/validate-steam-artwork.mjs",
    "test:profile": "node --experimental-strip-types scripts/validate-profile-card.mjs",
    "test:badges": "node --experimental-strip-types scripts/validate-profile-badges.mjs",
    "test:developer-center": "node --experimental-strip-types --test scripts/validate-developer-center.mjs",
    "typecheck:backend": "npm --prefix services/auth-api run typecheck",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
