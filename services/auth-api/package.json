{
  "name": "@achievement-nexus/auth-api",
  "private": true,
  "version": "0.2.0-beta.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types src/server.ts",
    "steam-openid:live-test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/steam-openid-live-test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/*.test.ts",
    "test:steam-openid": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/config.test.ts tests/openIdVerifier.test.ts tests/redaction.test.ts tests/requestSecurity.test.ts tests/steamOpenIdHttpClient.test.ts tests/steamAuthRoutes.test.ts",
    "test:storage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/storage.test.ts",
    "test:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/postgres.integration.test.ts",
    "test:authorization": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/authorization.test.ts",
    "test:persistent-sessions": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/desktopSessions.test.ts",
    "test:nexus-linked-accounts": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/nexusLinkedAccounts.test.ts",
    "test:postgres-nexus-linked-accounts": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/postgres.nexusLinkedAccounts.integration.test.ts",
    "test:nexus-identity-resolution": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/nexusIdentityResolution.test.ts",
    "test:postgres-nexus-identity-resolution": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/postgres.nexusIdentityResolution.integration.test.ts",
    "test:postgres-nexus-catalog": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/postgres.nexusCatalog.integration.test.ts",
    "test:release-channel": "node --test tests/releaseChannel.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@smithy/node-http-handler": "^4.9.13",
    "pg": "^8.16.3"
  }
}
